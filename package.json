{
  "name": "earwrm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:local": "node scripts/env-local.mjs",
    "build:local": "node scripts/with-local-env.mjs next build",
    "db:reset": "node scripts/db/target.mjs local -- db reset",
    "db:types": "node scripts/db/target.mjs local -- gen types typescript --schema public > src/data/database.types.ts",
    "test:db": "node scripts/db/target.mjs local -- test db",
    "verify:migrations": "node scripts/db/verify-migrations.mjs",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run build:local",
    "test:e2e:guard": "playwright test --config playwright.guard.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
