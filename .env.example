# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# MusicBrainz requires a descriptive User-Agent naming the app and a contact
# URL or address. Requests without one may be blocked.
MUSICBRAINZ_USER_AGENT=earwrm/0.1.0 ( https://github.com/vishnumadhav108/earwrm )

# Only needed for Settings > Delete account. Server-side, never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
